CREATE TABLE colegios_actividades (
	idreserva int identity(1,1) not null primary key,
	idcolegio int not null default(0) REFERENCES colegios (idcolegio) on delete cascade,
	idcharla smallint null REFERENCES charlas (idcharla) on delete no action,
	fecha date not null,
	numero_asistentes smallint not null
);
