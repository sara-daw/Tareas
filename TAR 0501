--Consulta numero 2
USE Potencial_Digital_SQL;
CREATE TABLE charlas (
	idcharla smallint identity(1,1) not null primary key,
	nombre varchar(255) not null unique,
	info_adicional varchar(max) null,
	puntacion_media decimal(4,2) null check(puntacion_media between 1 and 10) 
);
CREATE TABLE usuarios (
	idusuario int identity(1,1) not null primary key,
	nombre varchar(40) not null,
	telefono char(13) not null unique 
);
CREATE TABLE asistencia (
	idcharla smallint not null REFERENCES charlas (idcharla) on delete cascade on update cascade,
	idusuario int not null REFERENCES usuarios (idusuario) on delete cascade on update cascade,
	CONSTRAINT pk_compuesta primary key (idcharla,idusuario)
);
CREATE TABLE ponentes (
	idponente tinyint identity(1,1) not null primary key,
	nombre varchar(100) not null,
	gasto_total smallmoney null check(gasto_total>=0)
);
CREATE TABLE charlas_ponentes (
	idcharla smallint not null REFERENCES charlas (idcharla) on delete cascade on update cascade,
	idponente tinyint not null REFERENCES ponentes (idponente) on delete cascade on update cascade,
	CONSTRAINT pk_compuesta2 primary key (idcharla,idponente)
);
CREATE TABLE fechas ( 
	fecha date not null primary key default('2025-10-02')
); 
CREATE TABLE fechas_charlas (
	idcharla smallint not null REFERENCES charlas (idcharla) on delete cascade on update cascade,
	fechahora smalldatetime not null
);
